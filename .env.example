# Másold .env néven, és állítsd be.
# Melyik címen figyeljen a gépen:
#   127.0.0.1      – csak helyben (reverse proxy ugyanezen a gépen)
#   192.168.1.10   – a gép LAN-címe: otthoni wifiről elérhető
#   100.x.y.z      – a gép Tailscale-címe: csak a tailnetről
#   0.0.0.0        – minden interfész (csak ha a tűzfal szűr!)
BIND_ADDR=127.0.0.1
HOST_PORT=8000

MAX_UPLOAD_MB=2
BACKUP_ENABLED=1
BACKUP_KEEP_DAYS=14
LOG_LEVEL=INFO
TZ=Europe/Budapest
